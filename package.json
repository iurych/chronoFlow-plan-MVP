{
  "name": "chronoflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo 'CF-01 ok - APIs entram na CF-04'",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun --env-file=/home/iuryv/projetos/chronoFlow-plan-MVP/.env x --cwd packages/db drizzle-kit generate",
    "db:migrate": "bun --env-file=/home/iuryv/projetos/chronoFlow-plan-MVP/.env x --cwd packages/db drizzle-kit migrate",
    "db:seed": "bun --env-file=/home/iuryv/projetos/chronoFlow-plan-MVP/.env packages/db/src/seed.ts",
    "build": "echo \"CF-01 ok - build entra com os apps\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "jose": "^6.2.18",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "drizzle-kit": "^0.31.11"
  }
}
